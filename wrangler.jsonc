{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "payload-worker",
  "main": ".open-next/worker.js",

  "compatibility_date": "2026-03-10",

  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  // Static assets (Next.js / OpenNext)
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Default (local/dev)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "payload-db-dev",
      "database_id": "YOUR_DEV_DB_ID"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "payload-r2-dev"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "payload-r2-dev"
    }
  ],

  // ENV STRUCTURE (like your first config but clean)
  "env": {
    "production": {
      "name": "payload-worker-prod",

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "payload-db-prod",
          "database_id": "YOUR_PROD_DB_ID"
        }
      ],

      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "payload-r2-prod"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "payload-r2-prod"
        }
      ]
    },

    "test": {
      "name": "payload-worker-preview",

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "payload-db-preview",
          "database_id": "YOUR_TEST_DB_ID"
        }
      ],

      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "payload-r2-preview"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "payload-r2-preview"
        }
      ]
    }
  }
}